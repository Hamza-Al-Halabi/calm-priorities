# Copy to .env for local dev, or set these in Render's dashboard.

# API key from https://resend.com → API Keys (free tier is enough)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Sender address. Keep the Resend test sender until you verify your own
# domain in Resend. NOTE: with the test sender, Resend only delivers to
# the email address you signed up with.
FROM_EMAIL=onboarding@resend.dev

# Your deployed frontend URL, to lock down CORS (use * while testing)
FRONTEND_ORIGIN=*

# Optional — Render sets PORT automatically
PORT=3001
